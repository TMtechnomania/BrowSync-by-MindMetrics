{
	"name": "BrowSync",
	"version": "3.0",
	"manifest_version": 3,
	"description": "Your private productivity coach. Intelligently tracks time, focus, and context switches. All data stays 100% on your device.",
	"icons": {
		"16": "/icons/16.png",
		"48": "/icons/48.png",
		"128": "/icons/128.png"
	},
	"author": "buildwithkt",
	"homepage_url": "https://buildwithkt.dev/browsync",
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "/icons/16.png",
			"48": "/icons/48.png",
			"128": "/icons/128.png"
		}
	},
	"background": {
		"service_worker": "/js/service.js"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["/js/content.js"],
			"run_at": "document_start"
		}
	],
	"host_permissions": ["<all_urls>"],
	"permissions": [
		"alarms",
		"notifications",
		"storage",
		"tabs",
		"system.memory"
	],
	"web_accessible_resources": [
		{
			"resources": ["website.html"],
			"matches": ["<all_urls>"]
		}
	]
}
